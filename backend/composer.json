{
    "name": "groupe/decorator-app-backend",
    "description": "API PHP (sans framework) du projet Decorator : relevé de notes enrichi par des décorateurs",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "db:init": "@php database/initialize.php",
        "serve": "@php -S localhost:8000 -t public",
        "test": "@php tests/run.php"
    },
    "config": {
        "process-timeout": 0
    }
}
